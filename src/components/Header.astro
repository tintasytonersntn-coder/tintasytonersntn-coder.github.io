---
// src/components/Header.astro
---

<header>
  <nav class="nav-container">
    <a href="/" class="logo">
      <img src="/img/ntnlogo.jpeg" alt="Logo de NTN Tintas y Toners" />
    </a>
      <ul class="nav-links">
        <li><a href="/">Inicio</a></li>
        <li><a href="/#productos">Productos</a></li>
        <li><a href="/#nosotros">Sobre Nosotros</a></li>
        <li><a href="/#contacto">Contacto</a></li>
      </ul>
  </nav>
</header>

<style>
  header {
    position: sticky;
    top: 0;
    z-index: 50;
    width: 100%;
    background-color: rgba(26, 26, 26, 0.85); /* Fondo oscuro semi-transparente con efecto vidrio */
    backdrop-filter: blur(10px);
    -webkit-backdrop-filter: blur(10px);
    border-bottom: 1px solid rgba(255, 255, 255, 0.1);
  }

  .nav-container {
    max-width: 1200px;
    margin: 0 auto;
    padding: 0.75rem 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .logo img {
    height: 40px; /* Ajusta la altura de tu logo */
    width: auto;
    display: block;
  }

  .nav-links {
    display: flex;
    list-style: none;
    margin: 0;
    padding: 0;
    gap: 2rem;
  }

  .nav-links a {
    font-family: var(--font-display);
    color: var(--color-text-light);
    text-decoration: none;
    font-size: 1.1rem;
    text-transform: uppercase;
    padding: 0.5rem 0;
    position: relative;
    transition: color 0.3s ease;
  }

  .nav-links a:hover {
    color: var(--color-accent-cyan);
  }

  /* Animación de subrayado al pasar el mouse */
  .nav-links a::after {
    content: '';
    position: absolute;
    width: 100%;
    height: 2px;
    bottom: 0;
    left: 0;
    background-color: var(--color-accent-magenta);
    transform: scaleX(0);
    transform-origin: bottom right;
    transition: transform 0.3s ease-out;
  }

  .nav-links a:hover::after {
    transform: scaleX(1);
    transform-origin: bottom left;
  }

  /* --- Diseño Responsive para Móviles --- */
  /* Por ahora, hacemos que se centre. Más adelante podemos agregar un menú de hamburguesa. */
  @media (max-width: 768px) {
    .nav-container {
      flex-direction: column;
      gap: 1rem;
    }
    .nav-links {
      gap: 1.5rem;
    }
  }
</style>