---
// src/components/Contacto.astro

// --- CONFIGURACIÓN DE CONTACTO ---
const whatsappNumber = "5493585629340";
const whatsappMessage = "Hola, me gustaría hacer una consulta sobre sus productos.";
const whatsappUrl = `https://wa.me/${whatsappNumber}?text=${encodeURIComponent(whatsappMessage)}`;
const phone = "+54 9 358 562-9340";
const instagramUrl = "https://www.instagram.com/ntntintasytoners/?hl=es";
const facebookUrl = "https://www.facebook.com/ntn.tintas.toners/";
const tiktokUrl = "https://www.tiktok.com/@ntn.tintas.y.tone";
---
<section id="contacto">
    <div class="container">
        <h2>Contacto y Ubicación</h2>
        <p class="subtitle">Visitanos en nuestro local o contactanos por cualquiera de nuestros canales.</p>
        <div class="contact-grid">
            <div class="contact-info">
                <h3>Información de Contacto</h3>
                
                <div class="info-item">
                    <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 10c0 7-9 13-9 13s-9-6-9-13a9 9 0 0 1 18 0z"></path><circle cx="12" cy="10" r="3"></circle></svg>
                    </div>
                    <div>
                        <strong>Dirección:</strong>
                        <p>Dr. Carlos Gaudard 1439, Río Cuarto, Córdoba</p>
                    </div>
                </div>

                <div class="info-item">
                    <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><circle cx="12" cy="12" r="10"></circle><polyline points="12 6 12 12 16 14"></polyline></svg>
                    </div>
                    <div>
                        <strong>Horarios de Atención:</strong>
                        <p>Lunes a Viernes: 8:00 - 12:30 hs / 16:00 - 20:30 hs</p>
                        <p>Sábados: 9:00 - 13:00 hs</p>
                    </div>
                </div>

                <div class="info-item">
                     <div class="icon-wrapper">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M22 16.92v3a2 2 0 0 1-2.18 2 19.79 19.79 0 0 1-8.63-3.07 19.5 19.5 0 0 1-6-6 19.79 19.79 0 0 1-3.07-8.67A2 2 0 0 1 4.11 2h3a2 2 0 0 1 2 1.72 12.84 12.84 0 0 0 .7 2.81 2 2 0 0 1-.45 2.11L8.09 9.91a16 16 0 0 0 6 6l1.27-1.27a2 2 0 0 1 2.11-.45 12.84 12.84 0 0 0 2.81.7A2 2 0 0 1 22 16.92z"></path></svg>
                    </div>
                    <div>
                        <strong>Teléfono / WhatsApp:</strong>
                        <p><a href={whatsappUrl} target="_blank">{phone}</a></p>
                    </div>
                </div>

                <a href={whatsappUrl} target="_blank" rel="noopener noreferrer" class="cta-button">
                    <svg width="20" height="20" viewBox="0 0 24 24" fill="currentColor"><path d="M.057 24l1.687-6.163c-1.041-1.804-1.588-3.849-1.587-5.946.003-6.556 5.338-11.891 11.893-11.891 3.181.001 6.167 1.24 8.413 3.488 2.245 2.248 3.481 5.236 3.48 8.414-.003 6.557-5.338 11.892-11.894 11.892-1.99-.001-3.951-.5-5.688-1.448l-6.305 1.654zm6.597-3.807c1.676.995 3.276 1.591 5.392 1.592 5.448 0 9.886-4.434 9.889-9.885.002-5.462-4.415-9.89-9.881-9.892-5.452 0-9.887 4.434-9.889 9.886-.001 2.269.655 4.357 1.846 6.22l-1.078 3.928 3.978-1.043z"></path></svg>
                    <span>Enviar Mensaje</span>
                </a>

                <div class="social-links">
                    <a href={instagramUrl} target="_blank" rel="noopener noreferrer" aria-label="Instagram">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="2" width="20" height="20" rx="5" ry="5"></rect><path d="M16 11.37A4 4 0 1 1 12.63 8 4 4 0 0 1 16 11.37z"></path><line x1="17.5" y1="6.5" x2="17.51" y2="6.5"></line></svg>
                    </a>
                    <a href={facebookUrl} target="_blank" rel="noopener noreferrer" aria-label="Facebook">
                        <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M18 2h-3a5 5 0 0 0-5 5v3H7v4h3v8h4v-8h3l1-4h-4V7a1 1 0 0 1 1-1h3z"></path></svg>
                    </a>
                    <a href={tiktokUrl} target="_blank" rel="noopener noreferrer" aria-label="TikTok">
                         <svg viewBox="0 0 24 24" fill="currentColor"><path d="M12.525 1.229c-2.486 0-3.673.914-3.673 3.195 0 2.564 3.784 10.707 3.784 10.707.398 1.488-.588 1.944-1.782 1.944-1.42 0-2.433-.948-2.433-2.316 0-1.891 1.037-2.924 1.037-2.924s-5.263-.05-6.526 4.789c-1.264 4.838 4.671 7.269 7.42 7.269 3.064 0 5.609-2.074 5.609-5.918 0-4.14-3.04-10.978-3.04-10.978 2.05-.722 3.159-2.29 3.159-4.238 0-2.738-2.253-3.098-2.903-3.098Z"/></svg>
                    </a>
                </div>
            </div>
            <div class="contact-map">
                <iframe src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d3374.8870107779717!2d-64.36423862592837!3d-32.23594193892084!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x95d200312558618d%3A0x6444252554e20796!2sDr.%20Carlos%20Gaudard%201439%2C%20R%C3%ADo%20Cuarto%2C%20C%C3%B3rdoba!5e0!3m2!1ses-419!2sar!4v1724712497864!5m2!1ses-419!2sar" width="100%" height="100%" style="border:0;" allowfullscreen="" loading="lazy" referrerpolicy="no-referrer-when-downgrade"></iframe>
            </div>
        </div>
    </div>
</section>

<style>
/* Estilos generales sin cambios */
#contacto {
    padding: 4rem 2rem;
    background-color: var(--color-light-bg);
}
.container {
    max-width: 1200px;
    margin: 0 auto;
    text-align: center;
}
h2 {
    font-size: 2.5rem;
    margin-bottom: 1rem;
}
.subtitle {
    font-size: 1.1rem;
    color: var(--color-text-muted);
    margin-bottom: 3rem;
}
.contact-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 3rem;
    text-align: left;
}
.contact-info {
    display: flex;
    flex-direction: column;
    justify-content: center;
}
.info-item {
    display: flex;
    align-items: flex-start;
    gap: 1rem;
    margin-bottom: 1.5rem;
}
.icon-wrapper {
    background-color: var(--color-dark-bg);
    border-radius: 50%;
    padding: 0.75rem;
    display: flex;
    align-items: center;
    justify-content: center;
}
.info-item .icon-wrapper svg {
    width: 24px;
    height: 24px;
    stroke: var(--color-accent-cyan);
    flex-shrink: 0;
}
.info-item strong {
    font-family: var(--font-display);
    color: var(--color-text-light);
    font-size: 1.1rem;
}
.info-item p {
    margin: 0.25rem 0 0 0;
    color: var(--color-text-muted);
}
.info-item a {
    color: var(--color-text-muted);
    text-decoration: none;
    transition: color 0.3s ease;
}
.info-item a:hover {
    color: var(--color-accent-magenta);
}
.social-links {
    margin-top: auto;
    padding-top: 1.5rem;
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    display: flex;
    gap: 1.5rem;
}
.social-links a {
    color: var(--color-text-muted);
    transition: color 0.3s ease, transform 0.3s ease;
}
.social-links a:hover {
    color: var(--color-text-light);
    transform: scale(1.1);
}
.social-links svg {
    width: 28px;
    height: 28px;
}
.contact-map iframe {
    border-radius: 12px;
    width: 100%;
    height: 100%;
    min-height: 450px;
}

/* --- ===== SECCIÓN MODIFICADA DEL BOTÓN ===== --- */
.cta-button {
    display: inline-flex;
    align-items: center;
    gap: 0.75rem;
    padding: 0.8rem 1.75rem;
    margin-top: 1rem;
    align-self: flex-start;
    
    border: none;
    border-radius: 8px;
    text-decoration: none;
    font-weight: 700;
    font-family: var(--font-display);
    text-transform: uppercase;
    
    /* Estilo coherente con los botones del Hero */
    background-color: var(--color-accent-magenta);
    color: var(--color-dark-bg);
    
    transition: transform 0.2s ease, filter 0.2s ease;
}
.cta-button svg {
    width: 20px;
    height: 20px;
    fill: var(--color-dark-bg); /* El ícono de WhatsApp es relleno */
}
.cta-button:hover {
    transform: scale(1.05);
    filter: brightness(1.1);
}
/* ------------------------------------------- */

@media (max-width: 768px) {
    .contact-grid {
        grid-template-columns: 1fr;
    }
}
</style>